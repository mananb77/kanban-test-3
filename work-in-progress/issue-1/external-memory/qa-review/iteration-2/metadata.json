  "server_bug": {
    "file": "server/index.js",
    "lines": "19-22",
    "description": "Error handler ignores err.status; express.json() strict mode sends 400-level errors via next(err) for non-object/non-array JSON bodies (numbers and strings), but handler always returns 500",
    "severity": "HIGH",
    "fix": {
      "description": "Change error handler to forward err.status when present",
      "before": "res.status(500).json({ error: 'Internal server error' })",
      "after": "const status = err.status || err.statusCode || 500;\nres.status(status).json({ error: err.message || 'Internal server error' });"
    }
  },

